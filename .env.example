POSTGRES_DB=outcomes_annotator
POSTGRES_USER=outcomes_user
POSTGRES_PASSWORD=outcomes_password
DATABASE_URL=postgresql+psycopg://outcomes_user:outcomes_password@postgres:5432/outcomes_annotator
ENVIRONMENT=development
DEBUG=true
JWT_SECRET_KEY=replace-me-with-long-secret
JWT_REFRESH_SECRET_KEY=replace-me-with-long-refresh-secret
TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=/app/data/uploads
HIRING_AUDIO_HOST_DIR=/home/ubuntu/amc-data
HIRING_AUDIO_CONTAINER_DIR=/mnt/amc-data
TASK_MANIFEST_IMPORT_ROOTS=/mnt/amc-data
ACTIVITY_REPORT_TIMEZONE=Asia/Kolkata
HIRING_AUDIO_IMPORT_ROOTS=/mnt/amc-data
HIRING_AUDIO_IMPORT_MAX_FILES=5000
HIRING_AUDIO_IMPORT_MIN_FREE_BYTES=1073741824
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TIMEOUT_SECONDS=120
HIRING_DEEPGRAM_REFERENCE_MAX_FILES=2500
AUDIO_SIGNING_SECRET=replace-me-audio-secret
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
REDIS_URL=redis://redis:6379/0
JOBS_INLINE=false
LOGIN_RATE_LIMIT_ENABLED=true
PII_MODEL_PRELOAD_ENABLED=false
AUTO_SEED_DEV_USERS=true
